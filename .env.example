# Firebase web configuration.
#
# Only the API key is read from the environment; the rest of the config is in
# src/lib/firebase.ts because it is public and does not vary.
#
# This value is public by design — it identifies the Firebase project and grants nothing on its
# own. What protects a user's songs is firestore.rules, enforced server-side against their uid.
#
# With this unset the app builds without any Firebase at all (ADR-023): sign-in is not offered and
# songs are kept in local storage, exactly as they were before cloud sync existed.
VITE_FIREBASE_API_KEY=
